@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Monitoreo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-dark d-flex align-items-center justify-content-center vh-100">
<div class="card shadow-lg p-4 text-bg-secondary" style="width: 100%; max-width: 400px;">
    <h3 class="text-center mb-4 text-white fw-bold">Panel de Monitoreo</h3>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger py-2">@ViewBag.Error</div>
    }
    <form method="post" action="/Account/Login">
        <div class="mb-3">
            <label class="form-label text-white">Usuario</label>
            <input type="text" name="usuario" class="form-control" placeholder="Admin" required autofocus />
        </div>
        <div class="mb-3">
            <label class="form-label text-white">Contraseña</label>
            <input type="password" name="password" class="form-control" placeholder="••••••••" required />
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-2 fw-semibold">Ingresar</button>
    </form>
</div>
</body>
</html>