@{
    Layout = null;
    var nodos = ViewBag.Nodos as List<MonitoringApp.Monitoring.Core.Models.Nodo> ?? new();
    var dominios = ViewBag.Dominios as List<MonitoringApp.Monitoring.Core.Models.DominioExpiracion> ?? new();
    var alertas = ViewBag.Alertas as List<MonitoringApp.Monitoring.Core.Models.HistorialAlerta> ?? new();
    var config = ViewBag.Configuracion as MonitoringApp.Monitoring.Core.Models.ConfiguracionAlerta ?? new();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard de Infraestructura</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">⚡ InfraMonitor .NET 10</span>
    <div class="ms-auto d-flex align-items-center gap-3">
        <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#modalConfig">⚙ Parámetros</button>
        <span class="text-white-50">Usuario: <strong>@User.Identity?.Name</strong></span>
        <form action="/Account/Logout" method="post" class="m-0">
            <button class="btn btn-outline-danger btn-sm">Cerrar Sesión</button>
        </form>
    </div>
</nav>

<div class="container-fluid px-4">
    <!-- Métricas -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 p-3">
                <span class="text-muted small fw-bold">TOTAL NODOS</span>
                <h3 class="mb-0">@nodos.Count</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 p-3">
                <span class="text-muted small fw-bold">NODOS ONLINE</span>
                <h3 class="mb-0 text-success">@nodos.Count(n => n.Estado == "ONLINE")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 p-3">
                <span class="text-muted small fw-bold">NODOS OFFLINE</span>
                <h3 class="mb-0 text-danger">@nodos.Count(n => n.Estado == "OFFLINE")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 p-3">
                <span class="text-muted small fw-bold">DOMINIOS AUDITADOS</span>
                <h3 class="mb-0">@dominios.Count</h3>
            </div>
        </div>
    </div>

    <!-- Tabla Nodos -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold">Servidores Monitoreados (Nodos)</h5>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalNodo">+ Nuevo Nodo</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Estado</th>
                            <th>Nombre</th>
                            <th>IP</th>
                            <th>Token de Autenticación</th>
                            <th>Último Latido</th>
                            <th>Contenedores</th>
                            <th>Certificados SSL</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var nodo in nodos)
                    {
                        <tr>
                            <td>
                                <span class="badge @(nodo.Estado == "ONLINE" ? "bg-success" : "bg-danger")">
                                    @nodo.Estado
                                </span>
                            </td>
                            <td class="fw-bold">@nodo.Nombre</td>
                            <td><code>@nodo.IpDireccion</code></td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <small class="text-muted">@nodo.TokenAutenticacion</small>
                                    <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Gestionar Token" 
                                            onclick="abrirModalToken(@nodo.Id, '@nodo.Nombre', '@nodo.TokenAutenticacion')">🔑</button>
                                </div>
                            </td>
                            <td>@(nodo.UltimoLatido?.ToLocalTime().ToString("g") ?? "Nunca")</td>
                            <td>
                                @if (nodo.Contenedores.Any())
                                {
                                    @foreach (var c in nodo.Contenedores)
                                    {
                                        <span class="badge @(c.Estado == "running" ? "bg-primary" : "bg-secondary") mb-1">
                                            @c.Nombre (@c.Estado)
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Sin contenedores</span>
                                }
                            </td>
                            <td>
                                @if (nodo.CertificadosSsl.Any())
                                {
                                    @foreach (var cert in nodo.CertificadosSsl)
                                    {
                                        <span class="badge @(cert.DiasRestantes <= 15 ? "bg-danger" : "bg-info text-dark") mb-1">
                                            @cert.DominioHost (@cert.DiasRestantes d)
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Sin certs</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-primary" onclick="abrirModalConectar('@nodo.Nombre', '@nodo.TokenAutenticacion')">
                                        🚀 Conectar
                                    </button>
                                    <form action="/Dashboard/EliminarNodo" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar el nodo @nodo.Nombre?');">
                                        <input type="hidden" name="id" value="@nodo.Id" />
                                        <button class="btn btn-outline-danger">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Dominios -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold">Dominios & Expiración</h5>
                    <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalDominio">+ Agregar Dominio</button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Dominio</th>
                                <th>Proveedor</th>
                                <th>Expira</th>
                                <th>Días Restantes</th>
                                <th class="text-end pe-3">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var d in dominios)
                        {
                            <tr>
                                <td class="fw-bold">@d.NombreDominio</td>
                                <td>@d.ProveedorRegistro</td>
                                <td>@(d.FechaExpiracion?.ToString("d") ?? "Pendiente")</td>
                                <td>
                                    <span class="badge @(d.DiasRestantes <= 30 ? "bg-warning text-dark" : "bg-success")">
                                        @(d.DiasRestantes?.ToString() ?? "-") días
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <form action="/Dashboard/EliminarDominio" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar el dominio @d.NombreDominio?');">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button class="btn btn-outline-danger btn-sm py-0">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Alertas -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold">Historial de Alertas</h5>
                    @if (alertas.Any())
                    {
                        <form action="/Dashboard/LimpiarAlertas" method="post" onsubmit="return confirm('¿Vaciar todo el historial de alertas?');" class="m-0">
                            <button class="btn btn-outline-secondary btn-sm py-0">Vaciar</button>
                        </form>
                    }
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 250px;">
                        <table class="table table-sm table-striped mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Destinatario</th>
                                    <th>Estado</th>
                                    <th class="text-end pe-2"></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var a in alertas)
                            {
                                <tr>
                                    <td><small>@a.FechaCreacion.ToLocalTime().ToString("MM/dd HH:mm")</small></td>
                                    <td><span class="badge bg-secondary">@a.TipoOrigen</span></td>
                                    <td><small>@a.DestinatarioCorreo</small></td>
                                    <td>
                                        <span class="badge @(a.EnviadoExito ? "bg-success" : "bg-danger")">
                                            @(a.EnviadoExito ? "Enviado" : "Error")
                                        </span>
                                    </td>
                                    <td class="text-end pe-2">
                                        <form action="/Dashboard/EliminarAlerta" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@a.Id" />
                                            <button class="btn btn-link text-danger p-0 text-decoration-none" title="Eliminar">✕</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Desplegar Agente (Instrucciones Docker / Local) -->
<div class="modal fade" id="modalDespliegue" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">🚀 Configuración del Agente: <span id="despliegueNodoNombre" class="text-primary fw-bold"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs mb-3" id="despliegueTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold" id="podman-tab" data-bs-toggle="tab" data-bs-target="#tab-podman" type="button">🐳 Docker / Podman</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold" id="local-tab" data-bs-toggle="tab" data-bs-target="#tab-local" type="button">💻 Ejecución Local (.NET / CLI)</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold" id="json-tab" data-bs-toggle="tab" data-bs-target="#tab-json" type="button">📄 appsettings.json</button>
                    </li>
                </ul>

                <div class="tab-content" id="despliegueTabContent">
                    <!-- Tab 1: Docker / Podman -->
                    <div class="tab-pane fade show active" id="tab-podman">
                        <p class="small text-muted mb-2">Pega este comando en la terminal del cliente (crea el contenedor conectándose al socket del host):</p>
                        <div class="position-relative">
                            <pre class="bg-dark text-white p-3 rounded"><code id="codeDocker"></code></pre>
                            <button class="btn btn-sm btn-outline-light position-absolute top-0 end-0 m-2" onclick="copiarAlPortapapeles('codeDocker')">📋 Copiar</button>
                        </div>
                    </div>

                    <!-- Tab 2: Ejecución Local -->
                    <div class="tab-pane fade" id="tab-local">
                        <p class="small text-muted mb-2">Exporta las variables de entorno y ejecuta el proyecto directamente:</p>
                        <div class="position-relative">
                            <pre class="bg-dark text-white p-3 rounded"><code id="codeLocal"></code></pre>
                            <button class="btn btn-sm btn-outline-light position-absolute top-0 end-0 m-2" onclick="copiarAlPortapapeles('codeLocal')">📋 Copiar</button>
                        </div>
                    </div>

                    <!-- Tab 3: appsettings.json -->
                    <div class="tab-pane fade" id="tab-json">
                        <p class="small text-muted mb-2">Contenido para <code>Monitoring.Agent/appsettings.json</code>:</p>
                        <div class="position-relative">
                            <pre class="bg-dark text-white p-3 rounded"><code id="codeJson"></code></pre>
                            <button class="btn btn-sm btn-outline-light position-absolute top-0 end-0 m-2" onclick="copiarAlPortapapeles('codeJson')">📋 Copiar</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nuevo Nodo -->
<div class="modal fade" id="modalNodo" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" action="/Dashboard/CrearNodo" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Nuevo Nodo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre del Servidor</label>
                    <input type="text" name="nombre" class="form-control" placeholder="ej. VPS-Produccion-01" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">IP (Opcional)</label>
                    <input type="text" name="ip" class="form-control" placeholder="ej. 192.168.1.50" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Crear y Generar Token</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Renovar / Personalizar Token -->
<div class="modal fade" id="modalToken" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" action="/Dashboard/RenovarToken" class="modal-content">
            <input type="hidden" name="id" id="tokenNodoId" />
            <div class="modal-header">
                <h5 class="modal-title">Gestionar Token: <span id="tokenNodoNombre"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Token Actual</label>
                    <input type="text" id="tokenActual" class="form-control bg-light" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label">Nuevo Token Personalizado (Opcional)</label>
                    <input type="text" name="nuevoTokenPersonalizado" class="form-control" placeholder="Dejar en blanco para generar uno aleatorio" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-warning">Actualizar Token</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Nuevo Dominio -->
<div class="modal fade" id="modalDominio" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" action="/Dashboard/AgregarDominio" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Monitorear Nuevo Dominio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre de Dominio</label>
                    <input type="text" name="nombreDominio" class="form-control" placeholder="ej. github.com" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Proveedor</label>
                    <input type="text" name="proveedor" class="form-control" placeholder="ej. Cloudflare / Namecheap" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Registrar Dominio</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Configuración Global -->
<div class="modal fade" id="modalConfig" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" action="/Dashboard/ActualizarConfiguracion" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">⚙ Parámetros del Servidor & Alertas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Correo Destinatario de Alertas</label>
                    <input type="email" name="correo" class="form-control" value="@config.CorreoDestinatario" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Timeout Caída de Nodo (Segundos)</label>
                    <input type="number" name="timeout" class="form-control" value="@config.TimeoutSegundosNodo" min="30" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Aviso SSL (Días)</label>
                        <input type="number" name="diasSsl" class="form-control" value="@config.DiasAvisoSsl" min="1" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Aviso Dominio (Días)</label>
                        <input type="number" name="diasDominio" class="form-control" value="@config.DiasAvisoDominio" min="1" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Configuración</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function abrirModalToken(id, nombre, tokenActual) {
    document.getElementById('tokenNodoId').value = id;
    document.getElementById('tokenNodoNombre').innerText = nombre;
    document.getElementById('tokenActual').value = tokenActual;
    new bootstrap.Modal(document.getElementById('modalToken')).show();
}

function abrirModalConectar(nombre, token) {
    document.getElementById('nombreNodoConectar').innerText = nombre;
    
    // Detecta la URL base actual (ej. http://92.113.148.5:8585/api/HeartbeatApi)
    const baseUrl = window.location.origin + '/api/HeartbeatApi';
    const cleanName = nombre.toLowerCase().replace(/[^a-z0-9]/g, '-');

    // 1. Comando Docker / Podman (Imagen de Docker Hub)
    const dockerCmd = `podman run -d \\
  --name agent-${cleanName} \\
  -e AGENT_SERVER_URL="${baseUrl}" \\
  -e AGENT_TOKEN="${token}" \\
  -e AGENT_NODE_IP="$(hostname -I | awk '{print $1}')" \\
  -v \${XDG_RUNTIME_DIR:-/run}/podman/podman.sock:/var/run/docker.sock:ro \\
  --security-opt label=disable \\
  --restart unless-stopped \\
  marioalabi/infra-monitor-agent:latest`;
    
    document.getElementById('cmdDocker').innerText = dockerCmd;

    // 2. Comando Git / .NET CLI
    const gitCmd = `git clone https://github.com/TU_USUARIO/TU_REPO.git agent-${cleanName} && \\
cd agent-${cleanName} && \\
AGENT_SERVER_URL="${baseUrl}" \\
AGENT_TOKEN="${token}" \\
dotnet run --project MonitoringApp.csproj`;

    document.getElementById('cmdGit').innerText = gitCmd;

    new bootstrap.Modal(document.getElementById('modalConectarAgente')).show();
}

function copiarComando(elementId) {
    const texto = document.getElementById(elementId).innerText;
    navigator.clipboard.writeText(texto).then(() => {
        alert('¡Comando copiado al portapapeles!');
    });
}
</script>
<!-- Modal Estilo Cloudflare Connect -->
<div class="modal fade" id="modalConectarAgente" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold">🚀 Conectar Agente: <span id="nombreNodoConectar" class="text-warning"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted">Elige tu método de instalación para iniciar el agente recolector en el servidor o máquina cliente:</p>

                <!-- Selector de Entorno -->
                <ul class="nav nav-pills nav-fill mb-3" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#tab-docker" type="button">
                            🐳 Docker / Podman (Recomendado)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#tab-git" type="button">
                            🐙 Clonar con Git & .NET
                        </button>
                    </li>
                </ul>

                <div class="tab-content pt-2">
                    <!-- Opción 1: Docker / Podman -->
                    <div class="tab-pane fade show active" id="tab-docker">
                        <label class="form-label small fw-bold text-secondary">Ejecutar contenedor desde Docker Hub:</label>
                        <div class="position-relative">
                            <pre class="bg-dark text-light p-3 rounded font-monospace small"><code id="cmdDocker"></code></pre>
                            <button class="btn btn-sm btn-outline-warning position-absolute top-0 end-0 m-2" onclick="copiarComando('cmdDocker')">📋 Copiar</button>
                        </div>
                        <div class="alert alert-light border small text-muted mt-2">
                            💡 Conecta el socket local (Docker/Podman) en modo solo lectura (<code>:ro</code>) para detectar el estado de los contenedores automáticamente.
                        </div>
                    </div>

                    <!-- Opción 2: Git / .NET CLI -->
                    <div class="tab-pane fade" id="tab-git">
                        <label class="form-label small fw-bold text-secondary">One-liner para clonar, configurar y ejecutar con .NET:</label>
                        <div class="position-relative">
                            <pre class="bg-dark text-light p-3 rounded font-monospace small"><code id="cmdGit"></code></pre>
                            <button class="btn btn-sm btn-outline-warning position-absolute top-0 end-0 m-2" onclick="copiarComando('cmdGit')">📋 Copiar</button>
                        </div>
                        <div class="alert alert-light border small text-muted mt-2">
                            💡 Requiere .NET 10 SDK y Git instalados en la máquina cliente.
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
</body>
</html>